# Justflows — environment configuration
# Copy this file to .env and fill in the values before starting.
# Keep .env private and out of version control.
# ── Application ──────────────────────────────────────────────────────────────

# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# The public URL of your site (no trailing slash)
APP_URL=http://localhost:3000

# Node environment — use "development" locally; Docker/production images set this to production
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────

# Supported: postgres | mysql | mariadb
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=justflows
DB_USER=justflows
DB_PASSWORD=change-me

# The app's own DB client (apps/server/src/lib/db.ts) is built from the DB_*
# vars above and ignores this. But @justflows/core's loadConfig() — used by
# jf-cache, plugin-runtime, and a few other subsystems — reads this composed
# connection string instead and throws without it, which silently disables
# those subsystems (plugins fail to activate) if it's left unset.
# Must match DB_DRIVER's scheme, e.g. postgres://user:pass@host:port/dbname
DATABASE_URL=postgres://justflows:change-me@localhost:5432/justflows

# ── Storage ──────────────────────────────────────────────────────────────────

# Local filesystem (default — no extra services required)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# S3-compatible storage — AWS S3, Cloudflare R2, MinIO (comment out local above
# and uncomment below). Uploads keep the same per-site layout (<siteId>/...) and
# the same /uploads/... URLs. Copy existing local uploads first with
# `pnpm storage:sync` (add --dry-run to preview).
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=your-bucket
# STORAGE_S3_REGION=us-east-1            # R2: auto
# STORAGE_S3_ENDPOINT=                   # empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=your-access-key
# STORAGE_S3_SECRET_ACCESS_KEY=your-secret
# STORAGE_S3_FORCE_PATH_STYLE=           # default: on with a custom endpoint, off for AWS
# STORAGE_S3_PREFIX=                     # optional key prefix to share one bucket between installs
# STORAGE_S3_PUBLIC_URL=                 # optional public bucket / CDN URL; /uploads then redirects there

# Private files (downloads and other files plugins keep out of public view).
# They use, in order: a site's own connection (Settings → Storage, when its
# plan allows), the root site's connection, the S3 bucket above under
# `.private/` (not when STORAGE_S3_PUBLIC_URL makes it public), then this
# local folder. It must be outside STORAGE_LOCAL_PATH.
# PRIVATE_STORAGE_PATH=./storage/private

# ── Ports ────────────────────────────────────────────────────────────────────

# HTTP port for the unified server (API + admin + public site)
PORT=3000

# Interface to bind to. Defaults to 0.0.0.0 (all interfaces) — only needed to
# restrict the server to a single interface (e.g. loopback behind a proxy).
# HOSTNAME=0.0.0.0

# ── Logging ──────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ── Cache (jf-cache) ─────────────────────────────────────────────────────────
# Built-in object cache — similar to Next.js data cache. No Redis required.

# Enable (1/true/on) or disable (0/false/off) caching globally.
# The install wizard writes 0; turn it on in Admin → Tools → Performance.
CACHE_ENABLED=1

# Driver: memory | filesystem | redis (redis not yet implemented)
CACHE_DRIVER=filesystem

# Default TTL in seconds for cached entries
CACHE_TTL_SECONDS=300

# Filesystem driver — cache files directory (default: ./.cache under app root)
CACHE_DIR=./.cache

# Redis driver only (when implemented)
# CACHE_REDIS_URL=redis://localhost:6379

# Revalidate selected cache layers when content/menus/theme/settings change.
# The install wizard writes 0 for CACHE_REVALIDATE_ENABLED.
CACHE_REVALIDATE_ENABLED=1
CACHE_REVALIDATE_OBJECTS=pages,content,menus,theme,cssProviders,site

# When revalidation runs, also drop the site's pages at Bunny.net. Applies to every
# site that has not connected its own CDN under Admin → Settings → CDN. Leave unset to skip.
# BUNNY_API_KEY=
# BUNNY_PULL_ZONE_ID=

# ── Performance (GZIP + browser cache) ───────────────────────────────────────

# GZIP compression for HTML, JSON, CSS, JS (requires app restart after change).
# The install wizard writes 0.
JF_GZIP_ENABLED=1
JF_GZIP_LEVEL=6
JF_GZIP_MIN_BYTES=1024

# Browser Cache-Control headers for public HTML and static assets.
# The install wizard writes 0 for JF_BROWSER_CACHE_ENABLED.
JF_BROWSER_CACHE_ENABLED=1
JF_BROWSER_CACHE_HTML_MAX_AGE=60
JF_BROWSER_CACHE_STATIC_MAX_AGE=86400
JF_BROWSER_CACHE_SWR=300

# Concatenate every active plugin's client scripts/styles into one content-hashed
# bundle (/jf-plugins.<hash>.js|css) so a page loads one plugin script, not one
# per plugin. 0 = a <script> per plugin file (useful for debugging).
PLUGIN_ASSETS_BUNDLE=1

# ── Static / edge export ────────────────────────────────────────────────────
# Write published pages + assets to a folder for object storage / a CDN.
# See docs/STATIC-EXPORT.md. Run from Admin → System → Tools, `pnpm export:static`,
# or `justflows export static`. These keys are also editable (and applied without
# a restart) from Admin → System → Tools → Static site export → Configuration.
# Master switch. 0 = the Run actions and auto-rebuild are refused (existing
# files are left alone; clear them from Admin → Tools or `pnpm export:static -- --clear`).
STATIC_EXPORT_ENABLED=1
STATIC_EXPORT_DIR=./static-export
# local (default) or s3: reuse STORAGE_S3_*; no separate OVH credentials needed.
# S3 keeps a private per-site export under STORAGE_S3_PREFIX/static-export/sites/.
# Bunny can keep the existing app origin; the app signs bucket reads.
STATIC_EXPORT_STORAGE_DRIVER=local
# Public origin recorded in the manifest + used for same-origin link detection.
# Canonical tags and sitemap.xml URLs come from APP_URL, so normally leave this
# unset and point APP_URL at your public origin. Falls back to APP_URL.
# STATIC_EXPORT_BASE_URL=https://www.example.com
# Origin that still serves form/comment POST for a pure-static deployment. When
# set, exported pages submit forms by fetch() to this origin and show the
# confirmation in place. Leave unset for a hybrid CDN that proxies
# /justflows-forms/* etc. to Node (same result, no CORS).
# STATIC_EXPORT_ORIGIN_URL=https://app.example.com
# Extra origins allowed to cross-origin fetch() the submit endpoints (CORS).
# APP_URL / STATIC_EXPORT_BASE_URL and, outside production, any localhost port
# are always allowed. Comma-separated.
# STATIC_EXPORT_ALLOWED_ORIGINS=https://www.example.com
STATIC_EXPORT_MAX_PAGES=2000
STATIC_EXPORT_CONCURRENCY=4
# Re-run an incremental export after publish/unpublish/delete/menu/theme/settings
# changes. Needs CACHE_REVALIDATE_ENABLED=1 (that is what fires the trigger).
STATIC_EXPORT_AUTO=0
STATIC_EXPORT_DEBOUNCE_MS=5000

# ── Outgoing mail ────────────────────────────────────────────────────────────
# Defaults to local sendmail (same idea as PHP mail() / PHPMailer).
# Override in Admin → Settings, or set these if the host requires SMTP.

# MAIL_TRANSPORT=sendmail
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
# MAIL_TRANSPORT=smtp
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_SECURE=none
# SMTP_USER=
# SMTP_PASS=

# ── Self-service password reset ──────────────────────────────────────────────
# The emailed "forgot password" flow. Toggle it, or restrict it to specific
# roles, under Admin → Settings. Links are single-use and expire; this sets how
# long they stay valid (minutes, 5–1440; default 60). When outgoing mail is not
# configured, use `justflows user reset-password --email you@example.com`.
# JF_PASSWORD_RESET_TTL_MINUTES=60

# ── Installation state ───────────────────────────────────────────────────────
# Written automatically by the install wizard — do not edit manually.
# STATE=INSTALLED

# ── Database TLS ─────────────────────────────────────────────────────────────
# Defaults to ON whenever DB_HOST is not localhost — managed databases (Neon,
# RDS, PlanetScale) are reached over the network and must not be in cleartext.
# Set to 0 to disable, 1 to force it on for a local host too.
# DB_SSL=1
# Only for a self-signed server certificate. Leave alone otherwise.
# DB_SSL_REJECT_UNAUTHORIZED=0

# ── First-run install ────────────────────────────────────────────────────────
# Until setup completes, whoever reaches the site first could claim it and become
# its administrator. Justflows writes a one-time setup key to
# install-token/TOKEN.txt (and prints it to the log); the wizard asks for it.
# Requests from localhost are exempt, so local development is unaffected.
#
# Supply your own key for automated provisioning:
# JUSTFLOWS_INSTALL_TOKEN=
# ── Reverse proxy ────────────────────────────────────────────────────────────
# Which hops Express should trust for the client IP and the HTTPS flag. Accepts
# anything Express does: a hop count ("1"), a subnet, or "false" to trust none.
# Defaults to "loopback" — correct for nginx or Passenger on the same host. Get
# this wrong and per-IP rate limiting either collapses or becomes spoofable.
# TRUST_PROXY=loopback

# ── Package & update hardening ───────────────────────────────────────────────

# Since 0.1.2, plugin/theme/CSS-provider uploads are REJECTED unless they carry a
# valid marketplace signature or a digest you pinned below. Installing a package
# runs its code on your server, so this is on by default.
#
# Uncomment to install unsigned packages — for local development, or if you build
# your own packages and accept that they can do anything your server user can.
# JUSTFLOWS_ALLOW_UNSIGNED_PACKAGES=1

# Kept for compatibility with 0.1.1 configs. Signature checks are now the default,
# so setting this changes nothing except overriding the opt-out above.
# JUSTFLOWS_REQUIRE_SIGNED_PACKAGES=1

# Allow specific .jfpkg archives by package id and SHA-256 digest (comma-separated)
# Example: acme.my-plugin:abc123...,justflows.tailwind:def456...
# JUSTFLOWS_TRUSTED_PACKAGE_DIGESTS=

# Core updates are REJECTED unless they carry a valid Justflows release signature
# (justflows.zip.sig, published with every release), match the digest pinned
# below, or carry an HMAC made with the signing key below.

# Pin core update .zip to an expected SHA-256 digest of the full archive.
# While set, any other archive is refused, including official releases.
# JUSTFLOWS_UPDATE_DIGEST=

# Accept your own core builds signed with HMAC-SHA256 (hex digest of the zip buffer).
# Send via X-Justflows-Update-Signature header or upload body signature field.
# JUSTFLOWS_UPDATE_SIGNING_KEY=

# Uncomment to apply unsigned core updates — for local development only.
# JUSTFLOWS_ALLOW_UNSIGNED_CORE_UPDATES=1

# Kill switch for unattended updates. When set, the core and plugin/theme
# auto-update jobs never run and the "Automatic updates" toggle is disabled,
# whatever the admin chose. Manual updates still work.
# JUSTFLOWS_DISABLE_AUTO_UPDATE=1

# Media library ceilings, in megabytes. The first is the largest single upload;
# the second is the total the library may occupy for a site. Anyone who can
# upload can otherwise consume the whole volume, which takes the database down
# with it. Raise them if you host large video.
# JF_MAX_UPLOAD_MB=100
# JF_MAX_LIBRARY_MB=5120

# Responsive images (#103). On upload, raster images get width-scaled variants
# plus modern formats; image blocks and themes then emit <picture>/srcset with
# intrinsic width/height and lazy loading. Also editable in Admin -> Tools ->
# Responsive images (written back here, applied without a restart). SVGs are
# never rasterised. See docs/MEDIA.md.
# JF_IMAGE_DERIVATIVES=1                 # master switch; 0 stores originals only
# JF_IMAGE_RESPONSIVE_MARKUP=1           # emit <picture>/srcset on the public site;
#                                        # 0 serves originals everywhere (files kept)
# JF_IMAGE_WIDTHS=320,640,960,1280,1920  # variant widths in px (never upscaled)
# JF_IMAGE_MAX_WIDTH=2560                # cap on the largest generated width
# JF_IMAGE_FORMATS=webp                  # add avif for "webp,avif" (slower encode)
# JF_IMAGE_QUALITY_WEBP=82
# JF_IMAGE_QUALITY_AVIF=50
# JF_IMAGE_QUALITY_JPEG=82
# JF_IMAGE_STRIP_METADATA=1             # drop EXIF/GPS from generated variants
# JF_IMAGE_THUMB=400x400               # focal-point square thumbnail; "off" to skip
# JF_IMAGE_KEEP_ORIGINAL=              # filename globs kept as-is, e.g. logo*,*.png

# How long the administrative audit log is kept, in days. It records IP
# addresses, so it is personal data and keeping it forever is not lawful under
# GDPR Art. 5(1)(e). Applied from Admin -> Security -> Audit log.
# JF_AUDIT_RETENTION_DAYS=365

# How long form submissions are kept, in days. 0 (the default) keeps them
# indefinitely — set a window if you collect enquiries and have a retention
# policy to honour.
# JF_SUBMISSION_RETENTION_DAYS=0
