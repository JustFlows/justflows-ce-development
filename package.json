{
  "name": "justflows",
  "version": "0.4.3",
  "private": false,
  "description": "The open-source platform for building the web",
  "license": "MIT",
  "homepage": "https://github.com/JustFlows/justflows-ce#readme",
  "bugs": {
    "url": "https://github.com/JustFlows/justflows-ce/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustFlows/justflows-ce.git"
  },
  "keywords": [
    "cms",
    "justflows",
    "self-hosted",
    "open-source"
  ],
  "main": "server.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:security": "vitest run apps/server/tests/unit/security apps/server/tests/unit/auth apps/server/tests/unit/account/plugin-api-csrf apps/server/tests/unit/media/upload- apps/server/tests/unit/media/media-reservation apps/server/tests/unit/media/media-variant-jobs apps/server/tests/unit/storage/storage-quota apps/server/tests/unit/jobs/job-queue apps/server/tests/unit/ai/safe-fetch apps/server/tests/integration/middleware/api-key-auth apps/server/tests/integration/routes/auth apps/server/tests/integration/routes/system/install-rate-limit apps/server/tests/integration/security packages/installer/tests/unit/archive-safety packages/blocks/tests/unit/sanitize-document packages/blocks/tests/unit/document-limits packages/blocks/tests/unit/preview-safety packages/blocks/tests/unit/safe-url packages/sdk/tests/unit/capabilities packages/plugin-api/tests/unit/capability-registry",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "install:all": "\"${npm_node_execpath:-node}\" scripts/install-all.js",
    "install:production": "\"${npm_node_execpath:-node}\" scripts/install-all.js",
    "build:server": "\"${npm_node_execpath:-node}\" scripts/install-all.js --build-only",
    "make-zip": "bash scripts/make-zip.sh",
    "export:static": "node scripts/export-static.js",
    "storage:sync": "node scripts/storage-sync.js",
    "sdk:api:check": "node scripts/check-sdk-api.mjs",
    "sdk:api:update": "node scripts/check-sdk-api.mjs --update",
    "typecheck:tests": "pnpm -r --if-present typecheck:tests",
    "assets:report": "node scripts/check-asset-budgets.mjs",
    "assets:check": "node scripts/check-asset-budgets.mjs --check"
  },
  "dependencies": {
    "@justflows/blocks": "file:./packages/blocks",
    "@justflows/cache": "file:./packages/cache",
    "@justflows/content": "file:./packages/content",
    "@justflows/core": "file:./packages/core",
    "@justflows/installer": "file:./packages/installer",
    "@justflows/plugin-api": "file:./packages/plugin-api",
    "@justflows/sdk": "file:./packages/sdk",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
