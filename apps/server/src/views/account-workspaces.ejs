    <div id="account-content" <%= workspaces.length ? "" : "hidden" %>>
      <section class="workspace-switch"><label for="workspace-select">Workspace</label><select id="workspace-select"><% for (const item of workspaces) { %><option value="<%= item.id %>"><%= item.name %></option><% } %></select><span id="workspace-status" class="badge"><%= workspace?.status ?? "" %></span></section>
      <section id="workspace-details" class="panel"><div class="section-head"><h2>Workspace details</h2></div><form id="workspace-name-form"><label for="workspace-name">Workspace name</label><div class="input-row"><input id="workspace-name" name="name" value="<%= workspace?.name ?? "" %>" required maxlength="255"><button type="submit">Save name</button></div></form><p class="muted">Workspace ID <code id="workspace-id"><%= workspace?.id ?? "" %></code></p></section>

      <section class="panel"><div class="section-head"><div><h2>Your sites</h2><p class="muted">Each site has its own administration and sign-in.</p></div><button id="show-new-site" type="button">Create a site</button></div><div id="site-list"><% for (const site of workspace?.sites ?? []) { %><article class="site-row"><div><h3><%= site.name %></h3><p class="muted"><%= site.url || "No site address" %></p><span class="badge"><%= site.status %></span></div></article><% } %><% if (workspace && !workspace.sites.length) { %><p class="muted">No sites in this workspace yet.</p><% } %></div>
        <form id="new-site-form" hidden class="new-site"><h3>Create a site</h3><div class="form-grid"><label>Site name<input name="name" required maxlength="255" placeholder="My new site"></label><label>Site address<div class="address-input"><input name="address" required pattern="[a-z0-9][a-z0-9-]{1,38}[a-z0-9]" minlength="3" maxlength="40" placeholder="my-site"><span id="site-domain"></span></div></label><label>Site administrator password<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256"></label></div><p class="muted">Your account email is used for the site administrator. Choose a password of at least 12 characters. Your workspace's site allowance applies.</p><div class="input-row"><button type="submit">Create site</button><button id="cancel-new-site" class="secondary" type="button">Cancel</button></div></form>
      </section>
      <section class="panel"><div class="section-head"><div><h2>Resources and limits</h2><p class="muted">Limits are set by your plan. Choose a site to see its resources.</p></div></div><label for="resource-select">Resources for</label><select id="resource-select"><option value="workspace">Workspace</option><% for (const site of workspace?.sites ?? []) { %><option value="<%= site.id %>"><%= site.name %></option><% } %></select><div id="resource-list"><% if (meters === null && workspace) { %><p class="muted">Resources unavailable. Select resources to try again.</p><% } else { %><div class="resource-grid"><% for (const meter of meters ?? []) {
        const format = (n) => meter.unit === "bytes" ? `${(n / 1024 / 1024).toLocaleString(undefined, { maximumFractionDigits: 1 })} MB` : n.toLocaleString();
        const value = meter.unit === "flag" ? (meter.limit === 0 ? "Not included" : "Included") : `${meter.used === null ? "Usage unavailable" : format(meter.used)} / ${meter.limit === null ? "Unlimited" : format(meter.limit)}`;
      %><div class="resource-card"><p><%= meter.label %></p><strong><%= value %></strong></div><% } %></div><% } %></div></section>
    </div>
