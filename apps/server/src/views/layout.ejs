<!DOCTYPE html>
<html lang="<%= locale %>"<% if (typeof dir === 'string' && dir === 'rtl') { %> dir="rtl"<% } %><% if (typeof t === 'function') { %> data-jf-session-account="<%= t('auth.myAccount') %>" data-jf-session-signout="<%= t('auth.signOut') %>"<% } %>>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="Justflows <%= justflowsVersion %>">
  <% if (typeof discourageSearchEngines !=='undefined' && discourageSearchEngines) { %>
    <meta name="robots" content="noindex, nofollow">
    <% } %>
      <title>
        <%= title %>
      </title>
      <%- typeof headExtra !=='undefined' ? headExtra : '' %>
        <%- typeof analyticsHead !=='undefined' ? analyticsHead : '' %>
          <% if (typeof hreflangLinks !== 'undefined' && hreflangLinks.length) { %>
          <% hreflangLinks.forEach(function (alt) { %>
          <link rel="alternate" hreflang="<%= alt.locale %>" href="<%= alt.href %>">
          <% }); %>
          <% } %>
                  <!--jf:head-styles-->
                  <link rel="stylesheet"
                    href="<%= typeof themeCssHref === 'string' && themeCssHref ? themeCssHref : '/theme.css' %>">
                  <% if (typeof cssProviderStylesheets !=='undefined' && cssProviderStylesheets.length) { %>
                    <% cssProviderStylesheets.forEach(function(sheet) { %>
                      <link rel="stylesheet" href="<%= sheet.href %>">
                      <% }); %>
                        <% } %>
                          <!--jf:head-scripts-->
</head>

<body<% if (typeof bodyClass === 'string' && /^jf-layout-[a-z0-9-]+$/.test(bodyClass)) { %> class="<%= bodyClass %>"<% } %>>
    <%- typeof pwaBody !=='undefined' ? pwaBody : '' %>
      <%- body %>
      <footer class="site-footer">
        <% if (typeof footerBlocksHtml !=='undefined' && footerBlocksHtml) { %>
          <div class="site-footer-blocks"><%- footerBlocksHtml %></div>
          <% } else { %>
            <% if (typeof footerNavItems !=='undefined' && footerNavItems.length> 0) { %>
              <nav class="site-footer-nav" aria-label="<%= t('nav.footer') %>">
                <%- include('partials/nav-menu', {
                  items: footerNavItems,
                  menuDesign: typeof footerMenuDesign !== 'undefined' && footerMenuDesign ? footerMenuDesign : { layout: 'footer', activation: 'hover', breakpoint: 768, mobilePattern: 'accordion', alignment: 'start' },
                  menuId: 'footer',
                  currentPath: typeof publicPath !== 'undefined' ? publicPath : '',
                  t: typeof t === 'function' ? t : undefined,
                }) %>
              </nav>
              <% } %>
                <p>
                  <%= t('footer.powered_by') %> <a href="https://justflows.com"
                      style="color: var(--color-muted); text-decoration: none; font-weight: 600;">Justflows</a>
                </p>
                <% } %>
      </footer>
      <!--jf:body-scripts-->
</body>

</html>